  "targets": {},
  "rules": [
    {
      "id": "r-drive-download",
      "match": {
        "signals": [
          "drive_download"
        ],
        "ext": [
          "zip"
        ]
      },
      "category": "archives",
      "action": "move",
      "scope": "global",
      "confidence": 0.8,
      "hits": 0,
      "contradictions": 0,
      "source": "seed",
      "note": "Google Drive bulk downloads; disposable once extracted. Age policy archives old ones."
    },
    {
      "id": "r-firmware-release",
      "match": {
        "glob": "firmware-release-*.zip"
      },
      "category": "releases",
      "action": "move",
      "scope": "global",
      "confidence": 0.9,
      "hits": 0,
      "contradictions": 0,
      "source": "seed",
      "note": "Firmware release builds"
    },
    {
      "id": "r-device-backup",
      "match": {
        "glob": "*device-backup*.zip"
      },
      "category": "backups",
      "action": "move",
      "scope": "global",
      "confidence": 0.9,
      "hits": 0,
      "contradictions": 0,
      "source": "seed",
      "note": "Exported device backups"
    },
    {
      "id": "r-generic-image",
      "match": {
        "signals": [
          "generic_name"
